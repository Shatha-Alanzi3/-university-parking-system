<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حجز موقف - تقنية مواقف السيارات</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #3AB09E;
            color: white;
        }
        .navbar {
            display: flex;
            justify-content: center;
            background-color: #2c9e8d;
            padding: 15px 0;
        }
        .navbar a {
            color: white;
            text-decoration: none;
            margin: 0 25px;
            font-weight: bold;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: rgba(255, 255, 255, 0.15);
            padding: 30px;
            border-radius: 10px;
        }
        h2 {
            text-align: center;
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
        }
        input, select {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: none;
            border-radius: 5px;
        }
        input[type="submit"] {
            background-color: #2c9e8d;
            color: white;
            font-weight: bold;
            font-size: 1.1em;
            cursor: pointer;
            margin-top: 25px;
        }
        input[type="submit"]:hover {
            background-color: #227b6e;
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="index.html">الرئيسية</a>
        <a href="about.html">من نحن</a>
        <a href="services.html">خدماتنا</a>
        <a href="booking.html">الحجز</a>
    </nav>

    <div class="container">
        <h2>نموذج حجز موقف</h2>
        <form action="confirmation.html" method="get">
            <label for="name">الاسم كامل:</label>
            <input type="text" id="name" name="name" required>

            <label for="email">البريد الإلكتروني:</label>
            <input type="email" id="email" name="email" required>

            <label for="phone">رقم الهاتف:</label>
            <input type="tel" id="phone" name="phone" required>

            <label for="plate_number">رقم اللوحة:</label>
            <input type="text" id="plate_number" name="plate_number" required>

            <label for="car_type">نوع الموقف:</label>
            <select id="car_type" name="car_type" required>
                <option value="عادية">عادي</option>
                <option value="VIP">VIP</option>
            </select>

            <label for="date">تاريخ الحجز:</label>
            <input type="date" id="date" name="date" required>

            <label for="reservation_duration">مدة الحجز والسعر:</label>
            <select id="reservation_duration" name="reservation_duration">
                <option value="15">15 دقيقة - 0.75 ر.س</option>
                <option value="30">30 دقيقة - 1.5 ر.س</option>
                <option value="45">45 دقيقة - 2.25 ر.س</option>
                <option value="60">60 دقيقة - 3.0 ر.س</option>
            </select>

            <input type="submit" value="احجز الآن">
        </form>
    </div>

</body>
</html>

